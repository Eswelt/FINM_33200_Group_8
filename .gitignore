.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.doit.db
*.egg-info/
.env
.env.*

# Keep source-controlled placeholders, but do not commit downloaded data or model output.
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

docs_src/figures/*
docs_src/final_report.md
docs_src/data_glimpses.md
docs_src/reports/*.csv
docs_src/reports/*.json
docs_src/reports/*.md
docs_src/reports/figures/*
docs_src/reports/tables/*
docs_src/reports/notebooks/*
docs_src/reports/html/*
docs_src/reports/chartbook/*
!docs_src/reports/figures/.gitkeep
!docs_src/reports/tables/.gitkeep

# ChartBook may also emit a root-level reports/ build directory locally.
reports/

# Consolidated generated report outputs.
output/
